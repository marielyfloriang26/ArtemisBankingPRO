@model ArtemisBankingPro.Domain.Entities.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="fa-solid fa-pen-to-square me-2"></i>Editar Usuario: @Model.UserName</h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="Edit" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombre *</label>
                            <input type="text" name="nombre" class="form-control" value="@Model.Nombre" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Apellido *</label>
                            <input type="text" name="apellido" class="form-control" value="@Model.Apellido" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cédula *</label>
                            <input type="text" name="cedula" class="form-control" value="@Model.Cedula" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Correo Electrónico *</label>
                            <input type="email" name="email" class="form-control" value="@Model.Email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombre de usuario *</label>
                            <input type="text" name="userName" class="form-control" value="@Model.UserName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tipo de usuario (No modificable)</label>
                            <input type="text" class="form-control bg-light" value="@Model.TipoUsuario" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nueva Contraseña (Opcional)</label>
                            <input type="password" name="password" class="form-control" placeholder="Dejar en blanco para mantener actual" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Confirmar Nueva Contraseña</label>
                            <input type="password" name="confirmPassword" class="form-control" />
                        </div>

                        @if (Model.TipoUsuario == "Cliente")
                        {
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Monto adicional (Cuenta Principal)</label>
                                <input type="number" step="0.01" name="montoAdicional" class="form-control" value="0.00" min="0" />
                                <small class="text-muted">Este monto se sumará al balance actual de la cuenta de ahorro principal.</small>
                            </div>
                        }

                        <div class="col-12 d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>