@model IEnumerable<ArtemisBankingPro.Application.ViewModels.CuentaAhorro.ClientDebtViewModel>
@{
    ViewData["Title"] = "Seleccionar Cliente";
    string cedulaBusqueda = ViewBag.CedulaBusqueda as string ?? "";
}

<div class="container px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Seleccionar Cliente para Cuenta Secundaria</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Volver atrás
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="SelectClient" class="row g-3">
                <div class="col-md-10">
                    <input type="text" class="form-control" name="cedulaBusqueda" value="@cedulaBusqueda" placeholder="Buscar por cédula del cliente...">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="fas fa-search"></i> Buscar</button>
                </div>
            </form>
        </div>
    </div>

    <form method="get" asp-action="CreateSecondary">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">Seleccionar</th>
                                <th>Cédula</th>
                                <th>Nombre y Apellido</th>
                                <th>Correo electrónico</th>
                                <th>Monto total de deuda</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input" type="radio" name="clientId" value="@item.Cliente.Id" required>
                                        </td>
                                        <td><strong>@item.Cliente.Cedula</strong></td>
                                        <td>@item.Cliente.Nombre @item.Cliente.Apellido</td>
                                        <td>@item.Cliente.Email</td>
                                        <td>RD$ @item.MontoTotalDeuda.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No hay clientes activos disponibles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-lg">Siguiente paso <i class="fas fa-arrow-right ms-1"></i></button>
        </div>
    </form>
</div>