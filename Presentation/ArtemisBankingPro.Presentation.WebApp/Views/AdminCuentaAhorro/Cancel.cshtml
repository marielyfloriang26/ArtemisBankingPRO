@model ArtemisBankingPro.Domain.Entities.CuentaAhorro
@{
    ViewData["Title"] = "Cancelar Cuenta de Ahorro";
}

<div class="container py-5" style="max-width: 500px;">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Confirmación de Cancelación</h4>
        </div>
        <div class="card-body p-4 text-center">
            <div class="mb-3">
                <i class="fas fa-exclamation-triangle text-danger fa-3x"></i>
            </div>
            
            <h5 class="mb-3">¿Está seguro que desea cancelar la cuenta [@Model.NumeroCuenta]?</h5>
            <p class="text-muted small">Si la cuenta posee balance disponible (RD$ @Model.Balance.ToString("N2")), este será transferido automáticamente a la cuenta principal del cliente antes de cerrar la cuenta de forma definitiva.</p>

            <form asp-action="CancelConfirmed" method="post" class="mt-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>