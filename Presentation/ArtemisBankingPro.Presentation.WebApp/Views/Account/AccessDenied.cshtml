@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="alert alert-danger shadow-sm p-4 d-inline-block">
        <h4 class="alert-heading fw-bold">Acceso Denegado</h4>
        <p class="mb-3">No posee permisos para acceder a esta sección.</p>
        
        <hr>

        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="AdminHome" asp-action="Index" class="btn btn-primary px-4">Volver al Home</a>
        }
        else if (User.IsInRole("Cajero"))
        {
            <a asp-controller="Cajero" asp-action="Home" class="btn btn-primary px-4">Volver al Home</a>
        }
        else if (User.IsInRole("Cliente"))
        {
            <a asp-controller="Cliente" asp-action="Index" class="btn btn-primary px-4">Volver al Home</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4">Ir al Login</a>
        }
    </div>
</div>