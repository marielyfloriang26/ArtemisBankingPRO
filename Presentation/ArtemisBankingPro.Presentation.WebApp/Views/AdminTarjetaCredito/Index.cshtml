@model IEnumerable<ArtemisBankingPro.Application.ViewModels.AdminTarjeta.TarjetaAdminViewModel>
@{
    ViewData["Title"] = "Gestión de Tarjetas de Crédito";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-credit-card text-info me-2"></i>Gestión de Tarjetas de Crédito</h2>
        <a asp-action="SelectClient" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Asignar tarjeta de crédito
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtro por Cédula y Estado -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="cedula" class="col-form-label fw-bold">Buscar por cédula:</label>
                </div>
                <div class="col-auto">
                    <input type="text" name="cedula" id="cedula" class="form-control" value="@ViewBag.Cedula" placeholder="Ej: 001-0000000-1" />
                </div>
                <div class="col-auto">
                    <label for="estado" class="col-form-label fw-bold">Filtrar por estado:</label>
                </div>
                <div class="col-auto">
                    <select name="estado" id="estado" class="form-select">
                        <option value="Activas" selected="@(ViewBag.Estado == "Activas")">Activas</option>
                        <option value="Canceladas" selected="@(ViewBag.Estado == "Canceladas")">Canceladas</option>
                        <option value="Todas" selected="@(ViewBag.Estado == "Todas")">Todas</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary">Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-warning mt-3 mb-0">@ViewBag.ErrorMessage</div>
            }
        </div>
    </div>

    <!-- Tabla de Tarjetas -->
    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Número de tarjeta</th>
                        <th>Cliente</th>
                        <th>Límite de crédito</th>
                        <th>Fecha de expiración</th>
                        <th>Monto adeudado</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var tarjeta in Model)
                        {
                            <tr>
                                <td>@tarjeta.NumeroTarjeta</td>
                                <td>@tarjeta.Cliente</td>
                                <td>@tarjeta.LimiteCredito.ToString("C")</td>
                                <td>@tarjeta.FechaExpiracion</td>
                                <td>@tarjeta.MontoAdeudado.ToString("C")</td>
                                <td>
                                    @if (tarjeta.Estado == "Activa")
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Cancelada</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@tarjeta.Id" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    
                                    @if (tarjeta.Estado == "Activa")
                                    {
                                        <a asp-action="EditLimit" asp-route-id="@tarjeta.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form asp-action="Cancel" asp-route-id="@tarjeta.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro que desea cancelar la tarjeta @tarjeta.NumeroTarjeta.Substring(tarjeta.NumeroTarjeta.Length - 4)?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                                <i class="fa-solid fa-ban"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No se encontraron tarjetas de crédito registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Paginación -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-cedula="@ViewBag.Cedula" asp-route-estado="@ViewBag.Estado">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
