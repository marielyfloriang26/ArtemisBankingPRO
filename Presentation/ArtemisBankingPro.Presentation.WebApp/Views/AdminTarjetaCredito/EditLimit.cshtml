@model ArtemisBankingPro.Application.ViewModels.AdminTarjeta.EditLimiteTarjetaViewModel
@{
    ViewData["Title"] = "Editar Límite de Tarjeta";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="fa-solid fa-pen-to-square me-2"></i>Editar Límite de Tarjeta</h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="EditLimit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TarjetaId" />

                        <div class="mb-4">
                            <label asp-for="NuevoLimite" class="form-label fw-bold">Límite de la tarjeta *</label>
                            <div class="input-group">
                                <span class="input-group-text">RD$</span>
                                <input asp-for="NuevoLimite" type="number" step="0.01" min="0.01" class="form-control" required />
                            </div>
                            <span asp-validation-for="NuevoLimite" class="text-danger"></span>
                            <div class="form-text">El nuevo límite no puede ser menor al monto adeudado actualmente.</div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i> Volver atrás
                            </a>
                            <button type="submit" class="btn btn-warning">
                                Guardar cambios <i class="fa-solid fa-save ms-1"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
