@model IEnumerable<ArtemisBankingPro.Application.ViewModels.Prestamos.PrestamoViewModel>

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Préstamos</h2>
        <a asp-action="SelectClient" class="btn btn-primary">Asignar préstamo</a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <input type="text" name="cedula" class="form-control" placeholder="Buscar por cédula" value="@ViewBag.Cedula" />
            </div>
            <div class="col-md-3">
                <select name="estado" class="form-select">
                    <option value="Activos" selected="@(ViewBag.Estado == "Activos")">Activos</option>
                    <option value="Completados" selected="@(ViewBag.Estado == "Completados")">Completados</option>
                    <option value="Todos" selected="@(ViewBag.Estado == "Todos")">Todos</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary">Buscar</button>
            </div>
        </div>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Warning"]
        </div>
    }

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Capital Aprobado</th>
                    <th>Cuotas</th>
                    <th>Pagadas</th>
                    <th>Pendiente</th>
                    <th>Tasa Anual</th>
                    <th>Plazo</th>
                    <th>Estado Préstamo</th>
                    <th>Estado Cliente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NumeroPrestamo</td>
                            <td>@item.NombreCliente</td>
                            <td>@item.MontoAprobado.ToString("C")</td>
                            <td>@item.Cuotas.Count</td>
                            <td>@item.Cuotas.Count(c => c.EstadoPago == "Pagada")</td>
                            <td>@item.MontoPendiente.ToString("C")</td>
                            <td>@item.TasaInteresAnual %</td>
                            <td>@item.PlazoMeses meses</td>
                            <td>
                                <span class="badge @(item.Estado == "Activo" ? "bg-success" : "bg-secondary")">@item.Estado</span>
                            </td>
                            <td>
                                <span class="badge @(item.EstadoCliente == "Al día" ? "bg-success" : "bg-danger")">@item.EstadoCliente</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver detalles</a>
                                @if (item.Estado == "Activo")
                                {
                                    <a asp-action="EditRate" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">No hay préstamos registrados para la búsqueda.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación básica (asumiendo que ViewBag.CurrentPage y ViewBag.TotalPages existen) -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-cedula="@ViewBag.Cedula" asp-route-estado="@ViewBag.Estado">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
