@model IEnumerable<ArtemisBankingPro.Application.ViewModels.Prestamos.ClienteElegibleViewModel>

@{
    ViewData["Title"] = "Seleccionar Cliente";
}

<div class="container mt-4">
    <h2>Asignar préstamo - Selección de Cliente</h2>

    <div class="alert alert-info">
        <strong>Monto promedio de deuda del sistema:</strong> @(ViewBag.DeudaPromedio != null ? ((decimal)ViewBag.DeudaPromedio).ToString("C") : "$0.00")
    </div>

    <form method="get" class="mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <input type="text" name="cedula" class="form-control" placeholder="Buscar por cédula" value="@ViewBag.Cedula" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary">Buscar</button>
            </div>
        </div>
    </form>

    <form asp-action="SelectClientPost" method="post">
        
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Seleccionar</th>
                        <th>Cédula</th>
                        <th>Nombre y apellido</th>
                        <th>Correo electrónico</th>
                        <th>Monto total de deuda</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cliente in Model)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="radio" name="ClienteId" value="@cliente.Id" id="cliente_@cliente.Id" />
                                </td>
                                <td><label class="form-check-label" for="cliente_@cliente.Id">@cliente.Cedula</label></td>
                                <td><label class="form-check-label" for="cliente_@cliente.Id">@cliente.NombreCompleto</label></td>
                                <td><label class="form-check-label" for="cliente_@cliente.Id">@cliente.Correo</label></td>
                                <td><label class="form-check-label" for="cliente_@cliente.Id">@cliente.DeudaTotal.ToString("C")</label></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">No se encontraron clientes disponibles para asignar préstamos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary">Siguiente paso</button>
        </div>
    </form>
</div>
