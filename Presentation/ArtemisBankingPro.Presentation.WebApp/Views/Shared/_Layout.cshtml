    <link rel="stylesheet" href="~/css/artemis-theme.css" asp-append-version="true" />

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-3" style="background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.1);">
            <div class="container">
                <a class="navbar-brand fw-bold" href="#">
                    <i class="bi bi-bank2 text-primary me-2"></i> Artemis Banking Pro
                </a>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
=========================================================== -->

</body>
</html>