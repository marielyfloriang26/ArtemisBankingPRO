<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro</title>

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- FontAwesome para iconos bancarios -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .bank-navbar {
            background-color: #0f172a;
            color: #fff;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column justify-content-between">
    
    <!-- Header / Barra de Navegación del Banco -->
    <header class="bank-navbar shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark container py-3">
            <a class="navbar-brand fs-4 fw-bold text-white tracking-wide" href="#">
                <i class="fa-solid fa-building-columns text-info me-2"></i>Artemis Banking Pro
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-bars text-info"></i> Panel del  Administrador
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="AdminHome" asp-action="Index">
                                            <i class="fa-solid fa-house me-2 text-info"></i> Home
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="AdminUser" asp-action="Index">
                                            <i class="fa-solid fa-users-gear me-2 text-info"></i> Gestión de usuarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Prestamo" asp-action="Index">
                                            <i class="fa-solid fa-file-invoice-dollar me-2 text-info"></i> Gestión de préstamos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="AdminTarjetaCredito" asp-action="Index">
                                            <i class="fa-solid fa-credit-card me-2 text-info"></i> Gestión de tarjetas de crédito
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="AdminCuentaAhorro" asp-action="Index">
                                            <i class="fa-solid fa-piggy-bank me-2 text-info"></i> Gestión de cuentas de ahorro
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Cajero"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-bars text-info"></i> Panel del Cajero
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cajero" asp-action="Home">
                                            <i class="fa-solid fa-house me-2 text-info"></i> Home
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cajero" asp-action="Deposito">
                                            <i class="fa-solid fa-money-bill-transfer me-2 text-info"></i> Depósito
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cajero" asp-action="Retiro">
                                            <i class="fa-solid fa-money-bill-wave me-2 text-info"></i> Retiro
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cajero" asp-action="PagoTarjeta">
                                            <i class="fa-solid fa-credit-card me-2 text-info"></i> Pago a tarjeta de crédito
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cajero" asp-action="PagoPrestamo">
                                            <i class="fa-solid fa-file-invoice-dollar me-2 text-info"></i> Pago a préstamo
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cajero" asp-action="TransaccionTerceros">
                                            <i class="fa-solid fa-right-left me-2 text-info"></i> Transacciones a terceros
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-bars text-info"></i> Panel del Cliente
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow">
                                    <!-- Home -->
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cliente" asp-action="Index">
                                            <i class="fa-solid fa-house me-2 text-info"></i> Home
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>

                                    <!-- Transacciones (Menú principal y opciones específicas) -->
                                    <li><h6 class="dropdown-header text-uppercase text-muted fs-7">Transacciones</h6></li>
                                    <li>
                                        <a class="dropdown-item py-2 ps-4" asp-controller="Transaccion" asp-action="Index">
                                            <i class="fa-solid fa-list me-2 text-warning"></i> Transacciones
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 ps-4" asp-controller="Transaccion" asp-action="Express">
                                            <i class="fa-solid fa-bolt me-2 text-warning"></i> Transacciones - Express
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 ps-4" asp-controller="Transaccion" asp-action="Tarjeta">
                                            <i class="fa-solid fa-credit-card me-2 text-warning"></i> Transacciones - Tarjeta de crédito
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 ps-4" asp-controller="Transaccion" asp-action="Prestamo">
                                            <i class="fa-solid fa-file-invoice-dollar me-2 text-warning"></i> Transacciones - Préstamo
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 ps-4" asp-controller="Transaccion" asp-action="Beneficiario">
                                            <i class="fa-solid fa-users me-2 text-warning"></i> Transacciones - Beneficiarios
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>

                                    <!-- Otras operaciones del cliente -->
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Beneficiario" asp-action="Index">
                                            <i class="fa-solid fa-address-book me-2 text-info"></i> Beneficiarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cliente" asp-action="AvanceEfectivo">
                                            <i class="fa-solid fa-sack-dollar me-2 text-info"></i> Avance de efectivo
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Cliente" asp-action="Transferencia">
                                            <i class="fa-solid fa-right-left me-2 text-info"></i> Transferencia
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <div class="d-flex align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="text-white-50 me-3 small d-none d-md-inline">
                            <i class="fa-solid fa-user me-1"></i>@User.Identity.Name
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">
                                <i class="fa-solid fa-right-from-bracket me-1"></i> Cerrar sesión
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-white-50 small">Banca Digital Segura</span>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Pie de página institucional -->
    <footer class="text-center py-3 text-muted small bg-white border-top">
        <div class="container">
            &copy; 2026 Artemis Banking Pro. Todos los derechos reservados. | Portal Seguro de Autenticación
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

