<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro</title>
    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- FontAwesome para iconos bancarios -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .bank-navbar {
            background-color: #0f172a;
            color: #fff;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column justify-content-between">
    
    <!-- Header / Barra de Navegación del Banco -->
    <header class="bank-navbar shadow-sm py-3">
        <div class="container d-flex align-items-center justify-content-between">
            <span class="fs-4 fw-bold text-white tracking-wide">
                <i class="fa-solid fa-building-columns text-info me-2"></i>Artemis Banking Pro
            </span>
            <span class="text-white-50 small d-none d-sm-inline">Banca Digital Segura</span>
        </div>
    </header>

    <!-- Contenido Principal Centrado -->
    <main class="flex-grow-1 d-flex align-items-center justify-content-center py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Pie de página institucional -->
    <footer class="text-center py-3 text-muted small bg-white border-top">
        <div class="container">
            &copy; 2026 Artemis Banking Pro. Todos los derechos reservados. | Portal Seguro de Autenticación
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>