@model IEnumerable<ArtemisBankingPro.Application.ViewModels.Cliente.TransaccionDetalleViewModel>
@{
    ViewData["Title"] = "Detalle de Transacciones";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-list-check text-primary me-2"></i> Transacciones de la Cuenta</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver atrás
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y Hora</th>
                            <th>Monto</th>
                            <th>Tipo</th>
                            <th>Beneficiario</th>
                            <th>Origen</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fecha-local" data-utc="@item.FechaTransaccion.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                                            @item.FechaTransaccion.ToString("g")
                                        </span>
                                    </td>
                                    <td>RD$ @item.Monto.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(item.TipoTransaccion == "CRÉDITO" ? "bg-success" : "bg-danger")">
                                            @item.TipoTransaccion
                                        </span>
                                    </td>
                                    <td>@item.Beneficiario</td>
                                    <td>@item.Origen</td>
                                    <td class="text-center">
                                        <span class="badge @(item.Estado == "APROBADA" ? "bg-success" : "bg-secondary")">
                                            @item.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay transacciones registradas para esta cuenta.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.fecha-local').forEach(function (el) {
                const utcDate = el.getAttribute('data-utc');
                if (utcDate) {
                    const date = new Date(utcDate);
                    el.textContent = date.toLocaleString(undefined, {
                        year: 'numeric',
                        month: 'numeric',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    });
                }
            });
        });
    </script>
}