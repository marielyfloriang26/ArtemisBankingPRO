@using ArtemisBankingPro.Application.ViewModels.Beneficiarios
@model List<BeneficiarioViewModel>

@{
    ViewData["Title"] = "Beneficiarios";
    var showAddModal = ViewBag.ShowAddModal ?? false;
    var saveVm = new SaveBeneficiarioViewModel(); // For the Add modal form binding
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0 text-gray-800">Beneficiarios</h1>
                <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addBeneficiarioModal">
                    Agregar beneficiario
                </button>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Listado de Beneficiarios</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Número de cuenta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">@item.Nombre</td>
                                    <td class="align-middle">@item.Apellido</td>
                                    <td class="align-middle">@item.NumeroCuenta</td>
                                    <td class="align-middle">
                                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                            Eliminar
                                        </button>

                                        <!-- Delete Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="deleteModalLabel-@item.Id">Eliminar Beneficiario</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        ¿Está seguro que desea eliminar este beneficiario?
                                                    </div>
                                                    <div class="modal-footer">
                                                        <form asp-action="DeleteBeneficiario" asp-route-id="@item.Id" method="post">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-danger">Aceptar</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No hay beneficiarios registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Beneficiario Modal -->
<div class="modal fade @(showAddModal ? "show d-block" : "")" id="addBeneficiarioModal" tabindex="-1" aria-labelledby="addBeneficiarioModalLabel" aria-hidden="true" style="@(showAddModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddBeneficiario" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addBeneficiarioModalLabel">Agregar Beneficiario</h5>
                    @if (showAddModal)
                    {
                        <a href="@Url.Action("Index")" class="btn-close" aria-label="Close"></a>
                    }
                    else
                    {
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    }
                </div>
                <div class="modal-body text-start">
                    <div class="mb-3">
                        <label for="NumeroCuenta" class="form-label">Número de cuenta</label>
                        <input type="text" class="form-control" id="NumeroCuenta" name="NumeroCuenta" value="@(ViewData.ModelState["NumeroCuenta"]?.AttemptedValue ?? "")" required>
                        @Html.ValidationMessage("NumeroCuenta", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="modal-footer">
                    @if (showAddModal)
                    {
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    }
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
