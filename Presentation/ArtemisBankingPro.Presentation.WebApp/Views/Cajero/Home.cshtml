@{
    ViewData["Title"] = "Cajero - Home";
}

<div class="container mt-5 text-center">
    <h2>Panel de Cajero</h2>
    <p class="text-muted">Seleccione una operación a realizar</p>

    <div class="row justify-content-center mt-4">
        <div class="col-md-3 mb-3">
            <a asp-controller="Cajero" asp-action="Deposito" class="btn btn-outline-primary btn-lg w-100 p-4 shadow-sm">
                <i class="fs-1 bi bi-cash-stack d-block mb-2"></i> Depósito
            </a>
        </div>
        <!-- Aquí luego pondremos Retiro y Pago de Tarjeta -->
        <div class="col-md-3 mb-3">
            <button class="btn btn-outline-secondary btn-lg w-100 p-4 shadow-sm" disabled>
                <i class="fs-1 bi bi-wallet2 d-block mb-2"></i> Retiro (Próximamente)
            </button>
        </div>
    </div>
</div>