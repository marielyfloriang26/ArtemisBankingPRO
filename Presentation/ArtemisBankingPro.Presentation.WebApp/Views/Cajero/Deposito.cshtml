@model ArtemisBankingPro.Application.ViewModels.Cajero.DepositoViewModel
@{
    ViewData["Title"] = "Realizar Depósito";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Depósito a Cuenta de Ahorro</h4>
                </div>
                <div class="card-body">
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="Deposito" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NumeroCuenta" class="form-label">Número de Cuenta</label>
                            <input asp-for="NumeroCuenta" type="text" class="form-control" placeholder="Ej. 123456789" required />
                            <span asp-validation-for="NumeroCuenta" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Monto" class="form-label">Monto a Depositar</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Monto" type="number" step="0.01" class="form-control" required />
                            </div>
                            <span asp-validation-for="Monto" class="text-danger"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">Aplicar Depósito</button>
                            <a asp-action="Home" class="btn btn-light mt-2">Volver al Inicio</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}