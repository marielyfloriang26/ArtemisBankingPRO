@using ArtemisBankingPro.Application.ViewModels.CreditCards
@model List<CreditCardViewModel>

@{
    ViewData["Title"] = "Gestión de Tarjetas de Crédito";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0 text-gray-800">Tarjetas de Crédito</h1>
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Crear Nueva Tarjeta
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No hay tarjetas de crédito registradas en el sistema.
        </div>
    }
    else
    {
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Listado de Tarjetas</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Límite</th>
                                <th>Tasa de Interés</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">@item.Nombre</td>
                                    <td class="align-middle">@item.LimiteCredito.ToString("C")</td>
                                    <td class="align-middle">@item.TasaInteres%</td>
                                    <td class="align-middle">
                                        @if (item.Estado == "Activa")
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactiva</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-2">
                                            Editar
                                        </a>
                                        <form asp-action="ChangeStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @if (item.Estado == "Activa")
                                            {
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    Activar
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
