@using ArtemisBankingPro.Application.ViewModels.CreditCards
@model SaveCreditCardViewModel

@{
    ViewData["Title"] = "Editar Tarjeta de Crédito";
}

<style>
    .required-field::after {
        content: "*";
        color: red;
        margin-left: 2px;
    }
</style>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0 text-gray-800">Editar Tarjeta de Crédito</h1>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6 col-lg-8 col-md-10 mx-auto">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Detalles de la tarjeta</h6>
                </div>
                <div class="card-body">
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            Por favor, corrija los errores del formulario.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" asp-controller="CreditCard" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label text-dark fw-bold required-field">Nombre de la Tarjeta</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Visa Platinum" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LimiteCredito" class="form-label text-dark fw-bold required-field">Límite de Crédito</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="LimiteCredito" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="LimiteCredito" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TasaInteres" class="form-label text-dark fw-bold required-field">Porcentaje de Tasa de Interés (Anual)</label>
                            <div class="input-group">
                                <input asp-for="TasaInteres" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="TasaInteres" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CostoEmision" class="form-label text-dark fw-bold">Costo de Emisión</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CostoEmision" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="CostoEmision" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label text-dark fw-bold">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                Actualizar Tarjeta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
