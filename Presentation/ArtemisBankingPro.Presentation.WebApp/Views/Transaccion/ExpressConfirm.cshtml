@model ArtemisBankingPro.Application.ViewModels.Transacciones.ExpressConfirmViewModel

@{
    ViewData["Title"] = "Confirmar transacción";
}

<div class="container mt-4">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Confirmar Transacción Express</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Titular de la cuenta destino</dt>
                <dd class="col-sm-8">@Model.TitularCuentaDestino</dd>

                <dt class="col-sm-4">Número de cuenta destino</dt>
                <dd class="col-sm-8">@Model.NumeroCuentaDestino</dd>

                <dt class="col-sm-4">Monto a transferir</dt>
                <dd class="col-sm-8">RD$@Model.Monto.ToString("N2")</dd>
            </dl>

            <p class="fw-bold">¿Está seguro de que desea realizar esta transacción?</p>

            <form asp-action="ExpressConfirm" method="post" class="d-inline">
                <input type="hidden" asp-for="CuentaOrigenId" />
                <input type="hidden" asp-for="NumeroCuentaOrigen" />
                <input type="hidden" asp-for="NumeroCuentaDestino" />
                <input type="hidden" asp-for="Monto" />
                <input type="hidden" asp-for="TitularCuentaDestino" />
                <button type="submit" class="btn btn-primary">Confirmar</button>
            </form>
            <a asp-controller="Home" asp-action="Cliente" class="btn btn-secondary ms-2">Cancelar</a>
        </div>
    </div>
</div>
